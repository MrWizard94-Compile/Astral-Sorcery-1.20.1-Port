<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclusion filter for Astral Sorcery Port.

    Suppressions are added only for false positives specific to the
    Minecraft/Forge runtime model. Each entry has a comment explaining why.
-->
<FindBugsFilter>

    <!-- ── Mixin classes: suppress all findings ─────────────────────────────
         SpotBugs cannot model the Mixin runtime transformation.
         @Mixin classes appear to extend/implement classes they can never
         directly cast to at compile time — all findings are false positives.
    -->
    <Match>
        <Class name="~hellfirepvp\.astralsorcery\.mixin\..*"/>
    </Match>

    <!-- ── Test infrastructure ───────────────────────────────────────────── -->
    <Match>
        <Class name="~hellfirepvp\.astralsorcery\.test\..*"/>
    </Match>

    <!-- ── EI_EXPOSE_REP / EI_EXPOSE_REP2 / MS_EXPOSE_REP ──────────────────
         SpotBugs warns when a mutable field is returned directly or stored
         from a parameter without copying. In Minecraft all world/level data
         is intentionally mutable; defensive copies would break the engine's
         reference-equality contract (chunk sections, BlockPos arrays, etc.).
    -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="MS_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
        </Or>
    </Match>

    <!-- ── MS_CANNOT_BE_FINAL ────────────────────────────────────────────────
         Static fields populated by DeferredRegister/RegistryObject after
         class-load cannot be final. SpotBugs sees them as "could be final"
         because it does not model the Forge registration lifecycle.
    -->
    <Match>
        <Bug pattern="MS_CANNOT_BE_FINAL"/>
    </Match>

    <!-- ── MS_SHOULD_BE_FINAL / MS_PKGPROTECT / MS_MUTABLE_COLLECTION_PKGPROTECT
         Pure style suggestions that conflict with Forge registration patterns
         and the public API surface required by a mod library.
    -->
    <Match>
        <Or>
            <Bug pattern="MS_SHOULD_BE_FINAL"/>
            <Bug pattern="MS_PKGPROTECT"/>
            <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT"/>
        </Or>
    </Match>

    <!-- ── RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT ────────────────────────────
         Minecraft returns values from setters, state builders, and fluent
         constructors as a style convention. Nearly all of these are
         intentional (e.g., BlockState.setValue, ImmutableList.Builder.add).
    -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT"/>
    </Match>

    <!-- ── ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD ───────────────────────────
         Intentional singleton-init and lazy-registry patterns used throughout
         Forge mods. The static field is written exactly once (during
         onCommonSetup/onClientSetup) from the mod constructor/event handler.
    -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- ── CT_CONSTRUCTOR_THROW ───────────────────────────────────────────────
         BlockEntity subclasses must throw from their constructor in the Forge
         tile entity registration pattern when the ResourceLocation is invalid.
         This is unavoidable in the Forge 1.20.1 BlockEntity(BlockEntityType,
         BlockPos, BlockState) constructor contract.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- ── URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD ──────────────────────────────
         Public/protected API fields that are written by this mod and read by
         Forge or third-party mods at runtime. SpotBugs cannot see external
         readers.
    -->
    <Match>
        <Bug pattern="URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- ── NP_METHOD_PARAMETER_TIGHTENS_ANNOTATION ───────────────────────────
         Forge/Minecraft interfaces declare parameters without @Nonnull even
         when they are never null. Overriding methods that add @Nonnull are
         correct; the warning is a false positive caused by inconsistent
         upstream annotations.
    -->
    <Match>
        <Bug pattern="NP_METHOD_PARAMETER_TIGHTENS_ANNOTATION"/>
    </Match>

    <!-- ── NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE ────────────────────────────
         Minecraft Screen/Gui methods use MC's lazy-init pattern where fields
         like getMinecraft() and level/player are guaranteed non-null once
         init() runs. SpotBugs cannot model this lifecycle guarantee.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Class name="~hellfirepvp\.astralsorcery\.client\..*"/>
    </Match>

    <!-- ── PA_PUBLIC_PRIMITIVE_ATTRIBUTE ─────────────────────────────────────
         AmuletRandomizeHelper exposes tunable config fields intentionally as
         public static doubles for server-config wiring. Not a security issue
         in a single-player mod.
    -->
    <Match>
        <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
    </Match>

    <!-- ── RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE ──────────────────────────
         False positives when SpotBugs infers a value is @Nonnull from a prior
         check but the subsequent check is a defensive guard for future callers.
    -->
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>

    <!-- ── BX_UNBOXED_AND_COERCED_FOR_TERNARY_OPERATOR ───────────────────────
         Java numeric widening in ternary operators is compiler-correct; no
         semantic bug.
    -->
    <Match>
        <Bug pattern="BX_UNBOXED_AND_COERCED_FOR_TERNARY_OPERATOR"/>
    </Match>

    <!-- ── BC_VACUOUS_INSTANCEOF ──────────────────────────────────────────────
         Occurs in generated/ported Forge event handlers and covariant type
         guards that are correct by construction.
    -->
    <Match>
        <Bug pattern="BC_VACUOUS_INSTANCEOF"/>
    </Match>

    <!-- ── DCN_NULLPOINTER_EXCEPTION ─────────────────────────────────────────
         Catching NPE is used as a defensive pattern for broken third-party
         implementations of Forge capabilities and item handlers.
    -->
    <Match>
        <Bug pattern="DCN_NULLPOINTER_EXCEPTION"/>
    </Match>

    <!-- ── MS_MUTABLE_ARRAY ────────────────────────────────────────────────── -->
    <Match>
        <Bug pattern="MS_MUTABLE_ARRAY"/>
    </Match>

    <!-- ── DMI_RANDOM_USED_ONLY_ONCE for seeded deterministic Randoms ────────
         The remaining DMI_RANDOM_USED_ONLY_ONCE findings all use seeded
         Random(long seed) for deterministic / reproducible generation:
         sky star placement, constellation rendering, word generation,
         world-seed derivation. They cannot be replaced with ThreadLocalRandom
         because the seed is load-bearing. The two unseeded usages in
         PktParticleEvent and PktSyncConstellation were fixed to ThreadLocalRandom.
    -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
        <Or>
            <Class name="~hellfirepvp\.astralsorcery\.client\.sky\.AstralSkyRenderer"/>
            <Class name="~hellfirepvp\.astralsorcery\.client\.util\.RenderingConstellationUtils"/>
            <Class name="~hellfirepvp\.astralsorcery\.client\.screen\.ScreenTelescope"/>
            <Class name="~hellfirepvp\.astralsorcery\.client\.util\.word\.WordGeneratorChinese"/>
            <Class name="~hellfirepvp\.astralsorcery\.client\.util\.word\.WordGeneratorEnglish"/>
            <Class name="~hellfirepvp\.astralsorcery\.common\.util\.MiscUtils"/>
        </Or>
    </Match>

    <!-- ── RV_RETURN_VALUE_IGNORED_INFERRED for Minecraft model builders ─────
         PartDefinition.addOrReplaceChild() returns the child PartDefinition as
         a convenience reference for further chaining. In static (non-animated)
         block entity models, the child is registered into the parent mesh and
         the reference is never needed again — the whole mesh is baked at load
         time. Ignoring the return value is intentional and correct.
    -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_INFERRED"/>
        <Class name="~hellfirepvp\.astralsorcery\.client\.model\..*"/>
    </Match>

    <!-- ── BX_UNBOXING_IMMEDIATELY_REBOXED ───────────────────────────────────
         Triggered by Java's numeric promotion rules in ternary operators and
         generic collections. The compiler handles this correctly; no semantic
         bug is present.
    -->
    <Match>
        <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
    </Match>

    <!-- ── NP_NONNULL_RETURN_VIOLATION in AssetLibrary.prepare ──────────────
         SimplePreparableReloadListener<Void>.prepare() must return Void,
         which in Java can only be null. Returning null from a Void method is
         correct and intentional; this is a false positive.
    -->
    <Match>
        <Class name="hellfirepvp.astralsorcery.client.resource.AssetLibrary"/>
        <Method name="prepare"/>
        <Bug pattern="NP_NONNULL_RETURN_VIOLATION"/>
    </Match>

</FindBugsFilter>
