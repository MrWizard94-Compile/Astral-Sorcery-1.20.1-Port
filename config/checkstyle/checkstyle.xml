<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for Astral Sorcery Port (Forge 1.20.1 / Java 17).

    Rules focus on correctness and maintainability issues. Cosmetic style rules
    (indentation, brace placement) are intentionally left out — enforce those
    via IDE formatter instead.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <!-- Exclude generated sources and test infrastructure -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern"
                  value="src[\\/]generated[\\/]|AstralGameTests\.java|GameTestStructureProvider\.java"/>
    </module>

    <!-- ── File-level checks ──────────────────────────────────────────── -->

    <!-- No tab characters in source files -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- No trailing whitespace -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Line has trailing whitespace."/>
    </module>

    <!-- ── Tree-walker checks ─────────────────────────────────────────── -->
    <module name="TreeWalker">

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Blocks -->
        <!-- allowSingleLineStatement permits common guard idioms: if (x) return; -->
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="true"/>
            <property name="allowEmptyLoopBody" value="true"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Coding correctness -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="NoFinalizer"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean,java.lang.Integer"/>
        </module>
        <module name="MissingSwitchDefault"/>

        <!-- Numeric literals -->
        <module name="UpperEll"/>

        <!-- Modifier order (public protected private static final …) -->
        <module name="ModifierOrder"/>

        <!-- Avoid empty catch blocks that silently swallow exceptions -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
        </module>

        <!-- Fallthrough in switch without comment -->
        <module name="FallThrough"/>

        <!-- Simplifications -->
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

    </module>
</module>
